# Kullanım: Copy-Item .env.example .env  ve değerleri .env içinde doldur.
# .env git'e girmez; gerçek parola yalnız orada durur, bu dosyada yer tutucu kalır.
# Windows yollarında ters eğik çizgi YOK, ileri eğik çizgi kullanın (C:/makinist-veri/...): .env "properties" olarak okunur.

# PostgreSQL (docker-compose.yml `db` servisi ve backend bağlantısı aynı değerleri okur)
DB_ADI=makinist
DB_KULLANICI=makinist
DB_PAROLA=DEGISTIR
# Ana makinedeki port (5432 yerel PostgreSQL'e, 5433 ihale-takip'e ayrılmış)
DB_PORT=5434

# İlk yönetici (yalnız kullanıcı tablosu boşken tohumlanır; boşsa tohum yok)
MAKINIST_ADMIN_EPOSTA=
MAKINIST_ADMIN_SIFRE=

# Yedek betikleri (ops/yedekle.sh) buraya yazar. OneDrive DIŞINDA olmalı (içindeyse betik reddeder). Boşsa ~/makinist-yedek
YEDEK_DIZINI=C:/makinist-veri/yedek

# Oturum çerezi "secure" bayrağı: yerelde / düz http'de false, TLS (https) arkasında true
MAKINIST_COOKIE_SECURE=false

# Üretim (docker compose --profile app): uygulamanın ana makinedeki adresi ve portu.
APP_ADRESI=0.0.0.0
APP_PORT=8081
